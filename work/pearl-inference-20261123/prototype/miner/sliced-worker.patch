+
+/// Deterministic finite job. In --slice-check mode compare every ticket, nonce
+/// commitment and sample serialized proofs against unchanged full-round graphs.
+fn run_sliced(cli: &Cli, engine: &mut Engine, rounds: u32, guard: &nvml::Guard, job: &crate::protocol::MiningJob, gate: Option<&crate::handoff::Gate>) -> Result<()> {
+    let nonce = cli.bench_nonce.unwrap_or(0);
+    let mut reference = Vec::new();
+    if cli.slice_check {
+        engine.set_job(job, nonce)?;
+        for _ in 0..rounds {
+            guard.check()?;
+            engine.launch(0)?;
+            reference.push(engine.collect(0)?);
+        }
+    }
+    let (heap, root) = match &gate {
+        Some(g) => g.run(|| false, |_| Ok((engine.set_job(job, nonce)?, None)))?.unwrap(),
+        None => engine.set_job(job, nonce)?,
+    };
+    let cache = proof::ProofCache::new(engine.profile, heap, job.key, root)?;
+    let mut digest = blake3::Hasher::new();
+    let began = Instant::now();
+    let mut hits = 0;
+    let mut proof_samples = Vec::new();
+    let mut windows = Vec::new();
+    for n in 0..rounds {
+        let mut current = Vec::new();
+        let mut id = None;
+        for first in (0..Engine::TILE_COUNT).step_by(cli.slice_tiles as usize) {
+            guard.check()?;
+            let end = (first + cli.slice_tiles as usize).min(Engine::TILE_COUNT);
+            let mut op = |observe| {
+                let t = Instant::now();
+                let snap = engine.slice(first, end, observe)?;
+                if windows.len() < 100000 { windows.push(t.elapsed().as_secs_f64()*1e3); }
+                let stamp = snap.start_seen_ns;
+                Ok((snap, Some(stamp)))
+            };
+            let mut snap = match &gate {
+                Some(g) => g.run(|| false, op)?.unwrap(),
+                None => op(false)?.0,
+            };
+            ensure!(snap.overflow == 0, "sliced buffer overflow");
+            let meta = (snap.signal, snap.root_a);
+            ensure!(id.get_or_insert(meta) == &meta, "nonce changed within round");
+            current.append(&mut snap.groups);
+        }
+        current.sort_unstable();
+        let (signal, root_a) = id.unwrap();
+        if cli.slice_check {
+            let reference = &mut reference[n as usize];
+            reference.groups.sort_unstable();
+            ensure!(reference.overflow == 0 && reference.signal == signal && reference.root_a == root_a && reference.groups == current,
+                    "round {n}: sliced snapshot differs from unchanged production graph");
+        }
+        if let Some(&group) = current.first() {
+            if proof_samples.len() < 3 { proof_samples.push((group, signal, root_a)); }
+        }
+        digest.update(&signal); digest.update(&root_a);
+        digest.update(&(current.len() as u32).to_le_bytes());
+        for group in &current { digest.update(&group.to_le_bytes()); }
+        hits += current.len();
+    }
+    let seconds = began.elapsed().as_secs_f64();
+    ensure!(!proof_samples.is_empty(), "fixed job produced no proofs");
+    for (group, signal, root_a) in &proof_samples {
+        proof::verify(job, &cache.proof(*group, signal, root_a)?)?;
+    }
+    windows.sort_by(f64::total_cmp);
+    let pct = |q:f64| windows[((q*windows.len() as f64).ceil() as usize).max(1)-1];
+    println!("{}", json!({"k":engine.profile.k,"rounds":rounds,"slice_tiles":cli.slice_tiles,"tile_count":Engine::TILE_COUNT,
+        "compared_whole":cli.slice_check,"hits":hits,"verified_proofs":proof_samples.len(),"hit_digest":digest.finalize().to_hex().as_str(),
+        "seconds":seconds,"tmac_s":rounds as f64 * engine.profile.macs_per_round()/seconds/1e12,
+        "slice_host_to_completed_ms":{"p50":pct(0.50),"p95":pct(0.95),"p99":pct(0.99),"max":pct(1.0),"samples":windows.len()}}));
+    Ok(())
+}
diff --git a/src/handoff.rs b/src/handoff.rs
new file mode 100644
index 0000000..1232048
--- /dev/null
+++ b/src/handoff.rs
@@ -0,0 +1,172 @@
+//! Linux worker control. Exactly one GPU operation may be committed at a time.
+//! A HOLD and a new launch contend for the same mutex; proof work runs outside it.
+use anyhow::{ensure, Context, Result};
+use serde_json::json;
+use std::fs;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::Path;
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::Duration;
+
+#[derive(Default)]
+struct State {
+    holds: u64,
+    busy: bool,
+    watched: bool,
+    faulted: bool,
+    completed: u64,
+    release: u64,
+    first_begin: u64,
+    first_end: u64,
+    first_gpu_seen: u64,
+}
+
+pub struct Gate {
+    require_watch: bool,
+    state: Mutex<State>,
+    changed: Condvar,
+}
+
+pub fn monotonic_ns() -> u64 {
+    let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    assert_eq!(unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut t) }, 0);
+    t.tv_sec as u64 * 1_000_000_000 + t.tv_nsec as u64
+}
+
+impl Gate {
+    pub fn listen(path: &Path, require_watch: bool) -> Result<Arc<Self>> {
+        let parent = path.parent().context("worker socket needs a directory")?;
+        let dir = fs::metadata(parent)?;
+        ensure!(dir.is_dir() && dir.mode() & 0o077 == 0, "use a private (0700) control directory");
+        let server = UnixListener::bind(path).context("bind worker socket; use a fresh path")?;
+        fs::set_permissions(path, fs::Permissions::from_mode(0o600))?;
+        let gate = Arc::new(Self { require_watch, state: Mutex::new(State::default()), changed: Condvar::new() });
+        let control = gate.clone();
+        std::thread::Builder::new().name("pearl-control".into()).spawn(move || {
+            for stream in server.incoming() {
+                let Ok(stream) = stream else { break };
+                let gate = control.clone();
+                if std::thread::Builder::new().name("pearl-lease".into())
+                    .spawn(move || { let _ = gate.connection(stream); }).is_err() { break; }
+            }
+            control.fault();
+        })?;
+        Ok(gate)
+    }
+
+    fn fault(&self) {
+        self.state.lock().unwrap().faulted = true;
+        self.changed.notify_all();
+    }
+
+    fn connection(&self, mut stream: UnixStream) -> Result<()> {
+        let mut input = BufReader::new(stream.try_clone()?);
+        let mut command = String::new();
+        (&mut input).take(16).read_line(&mut command)?;
+        if command == "STATUS\n" {
+            let s = self.state.lock().unwrap();
+            let row = json!({"require_watch":self.require_watch,"watched":s.watched,"gpu_busy":s.busy,"holds":s.holds,"faulted":s.faulted,"completed_slices":s.completed,
+                "release_ns":s.release,"first_slice_begin_ns":s.first_begin,"first_slice_end_ns":s.first_end,"first_gpu_seen_ns":s.first_gpu_seen});
+            drop(s);
+            writeln!(stream, "{row}")?;
+            return Ok(());
+        }
+        if command == "WATCH\n" {
+            let mut s = self.state.lock().unwrap();
+            ensure!(self.require_watch && s.holds > 0 && !s.busy && !s.watched && !s.faulted,
+                "WATCH requires a drained, held, supervised worker");
+            s.watched = true;
+            drop(s);
+            // This connection has no further commands. EOF, unexpected data or a failed
+            // acknowledgement revokes the watch before any following permit can commit.
+            let observed = stream.write_all(b"WATCHING\n").and_then(|_| input.read(&mut [0u8]));
+            self.state.lock().unwrap().watched = false;
+            self.changed.notify_all();
+            observed?;
+            return Ok(());
+        }
+        ensure!(command == "HOLD\n", "invalid command");
+        let mut s = self.state.lock().unwrap();
+        s.holds += 1;
+        while s.busy && !s.faulted {
+            s = self.changed.wait(s).unwrap();
+        }
+        ensure!(!s.faulted, "worker stopped");
+        drop(s);
+        let result = (|| -> Result<()> {
+            stream.write_all(b"DRAINED\n")?;
+            command.clear();
+            (&mut input).take(16).read_line(&mut command)?;
+            ensure!(command == "RELEASE\n", "lease ended without explicit release");
+            Ok(())
+        })();
+        if let Err(e) = result {
+            // The caller may still be running inference. Restart this worker only after reconciliation.
+            self.fault();
+            return Err(e);
+        }
+        let mut s = self.state.lock().unwrap();
+        s.holds -= 1;
+        if s.holds == 0 {
+            s.release = monotonic_ns();
+            s.first_begin = 0;
+            s.first_end = 0;
+            s.first_gpu_seen = 0;
+        }
+        drop(s);
+        self.changed.notify_all();
+        stream.write_all(b"RELEASED\n")?;
+        Ok(())
+    }
+
+    /// Run cold GPU context and engine initialization under the same permit.
+    pub fn initialize<T>(gate: Option<&Self>, stop: impl Fn() -> bool, init: impl FnOnce() -> Result<T>) -> Result<T> {
+        match gate {
+            None => init(),
+            Some(g) => g.run(stop, |_| {
+                let initialized = init()?;
+                crate::cuda::synchronize_context()?;
+                Ok((initialized, None))
+            })?.context("worker stopped during initialization"),
+        }
+    }
+
+    /// The caller's closure must wait for the CUDA completion event before returning.
+    /// None means administrative/nonproductive work. Some holds the GPU start observation (0 if not sampled).
+    pub fn run<T>(&self, stop: impl Fn() -> bool, op: impl FnOnce(bool) -> Result<(T, Option<u64>)>) -> Result<Option<T>> {
+        let mut s = self.state.lock().unwrap();
+        while s.holds != 0 || s.faulted || (self.require_watch && !s.watched) {
+            if stop() { return Ok(None); }
+            // Administrative watchdog only. Releases and drains signal immediately.
+            s = self.changed.wait_timeout(s, Duration::from_millis(100)).unwrap().0;
+        }
+        if stop() { return Ok(None); }
+        assert!(!s.busy);
+        s.busy = true;
+        let observe_start = s.release != 0 && s.first_end == 0;
+        let begin = monotonic_ns();
+        drop(s);
+        let result = op(observe_start);
+        let end = monotonic_ns();
+        let mut s = self.state.lock().unwrap();
+        if let Ok((_, issued)) = &result {
+            if let Some(seen_ns) = *issued {
+                s.completed += 1;
+                if s.release > 0 && s.first_end == 0 {
+                    s.first_begin = begin;
+                    s.first_end = end;
+                    s.first_gpu_seen = seen_ns;
+                }
+            }
+        } else {
+            // A failed launch or event cannot certify that the GPU is idle.
+            s.faulted = true;
+        }
+        s.busy = false;
+        drop(s);
+        self.changed.notify_all();
+        result.map(|(value, _)| Some(value))
+    }
+}
