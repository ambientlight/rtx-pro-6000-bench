+            first = if end == Engine::TILE_COUNT { st.rounds += 1; 0 } else { end };
+            // GPU drain is acknowledged by the gate before this CPU queue can block.
+            deliver(state, log, a, proof_tx, &generation, &ctx, snap, st)?;
+            if last_stats.elapsed() > Duration::from_secs(30) {
+                log.event("stats", stats_row(state, st, true));
+                last_stats = Instant::now();
+            }
+        }
+    }
+    Ok(())
+}
