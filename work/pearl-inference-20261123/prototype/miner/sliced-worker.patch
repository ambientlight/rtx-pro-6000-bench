+#[allow(clippy::too_many_arguments)]
+fn deliver(state: &Arc<State>, log: &Log, a: &MineArgs, proof_tx: &crossbeam_channel::Sender<Option<ProofTask>>,
+        generation: &Generation, ctx: &Arc<ProofContext>, snap: Snapshot, st: &mut Stats) -> Result<()> {
+    if snap.overflow > 0 {
+        log.event("hit_overflow", json!({"dropped":snap.overflow,"capacity":a.hit_capacity}));
+    }
+    if !state.submittable(generation) {
+        if !snap.groups.is_empty() {
+            state.add_stale(snap.groups.len() as u64);
+            log.event("round_discarded", json!({"reason":"job_changed","job_id":generation.job.job_id,"sequence":snap.sequence,"shares":snap.groups.len()}));
+        }
+        return Ok(());
+    }
+    let mut dropped = 0;
+    for &group in &snap.groups {
+        let task = Some(ProofTask { generation: generation.clone(), ctx: ctx.clone(), group, signal: snap.signal, root_a: snap.root_a });
+        if a.control_socket.is_some() {
+            match proof_tx.try_send(task) {
+                Ok(()) => (),
+                Err(crossbeam_channel::TrySendError::Full(_)) => dropped += 1,
+                Err(crossbeam_channel::TrySendError::Disconnected(_)) => anyhow::bail!("proof worker disconnected"),
+            }
+        } else {
+            put(proof_tx, task, state)?;
+        }
+    }
+    if dropped > 0 { log.event("proof_queue_full", json!({"dropped":dropped,"sequence":snap.sequence})); }
+    st.max_proof_queue = st.max_proof_queue.max(proof_tx.len());
+    Ok(())
+}
