+/// Four aligned bytes of pinned CPU memory mapped for GPU system-scope stores.
+pub struct StartFlag {
+    host: *mut std::sync::atomic::AtomicU32,
+    pub device: CUdeviceptr,
+}
+impl StartFlag {
+    pub fn new() -> Result<Self> {
+        let mut host = std::ptr::null_mut();
+        let mut device = 0;
+        unsafe {
+            check(cuMemHostAlloc(&mut host, 4, 2), "cuMemHostAlloc(DEVICEMAP)")?;
+            if let Err(error) = check(cuMemHostGetDevicePointer_v2(&mut device, host, 0), "map GPU start flag") {
+                cuMemFreeHost(host);
+                return Err(error);
+            }
+            host.cast::<std::sync::atomic::AtomicU32>().write(std::sync::atomic::AtomicU32::new(0));
+        }
+        Ok(Self { host: host.cast(), device })
+    }
+    pub fn clear(&self) { unsafe { &*self.host }.store(0, std::sync::atomic::Ordering::SeqCst); }
+    pub fn seen(&self) -> bool { unsafe { &*self.host }.load(std::sync::atomic::Ordering::Acquire) != 0 }
+}
+impl Drop for StartFlag {
+    fn drop(&mut self) { unsafe { cuMemFreeHost(self.host.cast()) }; }
+}
