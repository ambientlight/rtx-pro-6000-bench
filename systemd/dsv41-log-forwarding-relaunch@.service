[Unit]
Description=One-shot dsv41 log-forwarder rollout after 60 seconds idle (%i)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/hot

[Service]
Type=simple
WorkingDirectory=/mnt/hot/ambientlight/repos/rtx-pro-6000-bench
ExecStart=/usr/bin/python3 -u /mnt/hot/ambientlight/repos/rtx-pro-6000-bench/scripts/dsv41_relaunch_log_forwarder.py watch --state-dir /mnt/hot/dsv41_state/%i
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=no
UMask=0077
TimeoutStopSec=20
StandardOutput=append:/mnt/hot/dsv41_state/%i/watcher.log
StandardError=append:/mnt/hot/dsv41_state/%i/watcher.log
