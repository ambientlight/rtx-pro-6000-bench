[Unit]
Description=Deferred dsv41 RAM HiCache rollout (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/hot/ambientlight/repos/rtx-pro-6000-bench
ExecStart=/usr/bin/python3 -u /mnt/hot/ambientlight/repos/rtx-pro-6000-bench/scripts/dsv41_deferred_relaunch.py watch --state-dir /mnt/hot/dsv41_state/%i
Restart=no
UMask=0077
TimeoutStopSec=20
StandardOutput=append:/mnt/hot/dsv41_state/%i/watcher.log
StandardError=append:/mnt/hot/dsv41_state/%i/watcher.log
