[Unit]
Description=Continuously capture V4.1 production HTTP and native inference output
After=default.target
RequiresMountsFor=/mnt/hot

[Service]
Type=simple
Environment=DSV4_DUMP_CONTAINER=dsv41
Environment=DSV4_DUMP_ROOT=/mnt/hot/dsv41_dumps
Environment=DSV4_DUMP_PORT=8000
Environment=DSV4_DUMP_BASE_URL=http://127.0.0.1:8000
Environment=DSV4_DUMP_INTERFACE=any
ExecStart=/mnt/hot/ambientlight/repos/rtx-pro-6000-bench/scripts/dsv4_continuous_dump.sh
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
