[Unit]
Description=Passive DSV4.1 FULL/SWA RAM-cache pressure monitoring
After=default.target
RequiresMountsFor=/mnt/hot

[Service]
Type=simple
ExecStart=/usr/bin/python3 /mnt/hot/ambientlight/repos/rtx-pro-6000-bench/scripts/dsv41_cache_monitor.py --interval 30
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
Nice=10

[Install]
WantedBy=default.target
