[Unit]
Description=Continuously dump exact DSV4 request/response traffic
After=default.target
RequiresMountsFor=/mnt/hot

[Service]
Type=simple
ExecStart=/mnt/hot/ambientlight/repos/rtx-pro-6000-bench/scripts/dsv4_continuous_dump.sh
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
