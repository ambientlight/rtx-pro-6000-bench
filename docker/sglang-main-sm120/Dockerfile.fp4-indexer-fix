ARG BASE_IMAGE=ambientlight/sglang-main-sm120:b03ac355-cu130-candidate
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="sglang-main-dsv4-sm120-fp4-indexer-fix" \
      org.opencontainers.image.description="Pinned SGLang main with the minimal SM120 FP4-indexer/TileLang compatibility guard" \
      org.opencontainers.image.revision="b03ac355e795b3a86b26b8732c47c0965fd71bbc" \
      ai.sglang.comparison.role="native-main-fp4-indexer-experiment" \
      ai.sglang.patch.fp4-indexer-tilelang-guard="true"

COPY patches/fp4-indexer-sm120-tilelang-guard.patch /tmp/fp4-indexer-sm120-tilelang-guard.patch
RUN cd /opt/sglang-main \
 && git apply --check /tmp/fp4-indexer-sm120-tilelang-guard.patch \
 && git apply /tmp/fp4-indexer-sm120-tilelang-guard.patch \
 && python3 -c "from pathlib import Path; p=Path('/opt/sglang-main/python/sglang/srt/server_args.py').read_text(); assert 'if not self.enable_deepseek_v4_fp4_indexer:' in p; print('SM120 FP4 indexer TileLang guard applied')"

ENV SGLANG_IMAGE_TAG=ambientlight/sglang-main-sm120:b03ac355-cu130-fp4-indexer-fix
