ARG BASE_IMAGE=ambientlight/sglang-main-sm120:b03ac355-cu130-candidate
FROM ${BASE_IMAGE}

ARG SGLANG_SHA=b03ac355e795b3a86b26b8732c47c0965fd71bbc
ARG RELEASE_TAG=2026.08.0-cu130-sm120a

LABEL org.opencontainers.image.title="sglang-dsv4-sm120" \
      org.opencontainers.image.description="Benchmark-qualified SGLang main for DeepSeek-V4-Flash MXFP4 on SM120 TP4" \
      org.opencontainers.image.revision="${SGLANG_SHA}" \
      org.opencontainers.image.version="${RELEASE_TAG}" \
      ai.sglang.comparison.role="benchmark-qualified-release" \
      ai.sglang.performance-gate="passed" \
      ai.sglang.performance-gate.workload="8K/64K input, 1K output, concurrency 1/2/4/8/16, TP4, 300W" \
      ai.sglang.performance-gate.results="bench/deepseek-v4-sm120-main-compare-20260820"

ENV SGLANG_IMAGE_TAG=ambientlight/sglang-sm120-mxfp4:${RELEASE_TAG}
