# Fatal-path-only layer; the builder verifies the immutable local parent tag.
FROM ambientlight/dsv41-sm120:responses-prefix-v1
ARG SOURCE_MANIFEST_SHA256
LABEL dev.idle.crash-diagnostics="bounded-v1" \
      dev.idle.parent.image="sha256:90d0ef76ed2da4a1bae09a7b9db015bf377952ac77a4b002d3892ce993cc13c3" \
      dev.idle.source.manifest.sha256="${SOURCE_MANIFEST_SHA256}"
COPY python/sglang/srt/environ.py /sgl-workspace/sglang/python/sglang/srt/environ.py
COPY python/sglang/srt/managers/tokenizer_manager.py /sgl-workspace/sglang/python/sglang/srt/managers/tokenizer_manager.py
COPY python/sglang/srt/utils/watchdog.py /sgl-workspace/sglang/python/sglang/srt/utils/watchdog.py
COPY python/sglang/srt/utils/cudacore_pyspy_dump_utils.py /sgl-workspace/sglang/python/sglang/srt/utils/cudacore_pyspy_dump_utils.py
COPY source-manifest.json /opt/dsv41/diagnostics-source-manifest.json
ENV TORCH_NCCL_EXTRA_DUMP_ON_EXEC=1 \
    SGLANG_CRASH_DIAGNOSTICS_TIMEOUT_SECS=60 \
    SGLANG_PYSPY_DUMP_TIMEOUT_SECS=5 \
    SGLANG_PYSPY_DUMP_TOTAL_TIMEOUT_SECS=20 \
    SGLANG_PYSPY_DUMP_NATIVE=1 \
    SGLANG_NCCL_DUMP_BEFORE_CRASH=1 \
    SGLANG_NCCL_DUMP_BEFORE_CRASH_WAIT_SECS=10 \
    SGLANG_CUDA_COREDUMP_BEFORE_CRASH_WAIT_SECS=60
