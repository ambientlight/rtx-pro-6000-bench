[Unit]
Description=Select DeepSeek or native mining memory clocks from the live broker permit
After=dsv41-pearl.service
PartOf=dsv41-pearl.service
ConditionPathExists=/run/dsv41-memory-clock.sock

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/libexec/dsv41-watch-clock.py
Restart=on-failure
RestartSec=2s
TimeoutStopSec=4s

[Install]
WantedBy=dsv41-pearl.service
