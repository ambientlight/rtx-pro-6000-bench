[Unit]
Description=Hold 7001 MHz memory clocks for one native mining lease
CollectMode=inactive-or-failed

[Service]
Type=exec
# The unprivileged controller holds the connected socket open while mining.
# Closing the socket makes head return, including when the controller exits.
StandardInput=socket
StandardOutput=null
StandardError=journal
ExecStartPre=/usr/bin/nvidia-smi --id=GPU-ed6c5013-1e0a-ec80-be70-9aab1629ba5d,GPU-401b534a-f12c-63a0-def4-429e3bfa6ef6,GPU-36bcefcc-7d05-78d1-7e86-08f29dd2409b,GPU-b000b08e-8683-d776-925b-a9704b764ddc --lock-memory-clocks=7001,7001
ExecStart=/usr/bin/head -c 1
ExecStopPost=/usr/bin/nvidia-smi --id=GPU-ed6c5013-1e0a-ec80-be70-9aab1629ba5d,GPU-401b534a-f12c-63a0-def4-429e3bfa6ef6,GPU-36bcefcc-7d05-78d1-7e86-08f29dd2409b,GPU-b000b08e-8683-d776-925b-a9704b764ddc --reset-memory-clocks
TimeoutStartSec=12s
TimeoutStopSec=12s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
