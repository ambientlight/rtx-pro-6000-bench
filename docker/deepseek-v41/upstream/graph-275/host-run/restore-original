#!/usr/bin/env bash
set -eu
for u in dsv41-graph275-candidate.service dsv41-pearl-graph275-miners.service dsv41-graph275-peer.service dsv41-graph275-equal-peer.service; do
  if systemctl --user is-active --quiet "$u"; then systemctl --user stop "$u"; fi
done
docker --context shared-operator start dsv41
