#!/usr/bin/env bash
set -eu
d=/mnt/hot/ambientlight/sglang-sm120-runtime/graph-production-275
arm="${1:?switch or joined}"; shift
case "$arm" in
switch) opts=() ;;
joined) opts=(--setenv=PEARL_WOB_MODULE=checkpoint_graph --setenv=PEARL_GRAPH_VERIFY=1 --setenv=PEARL_GPU_PREPARE=1 --setenv=PEARL_REPLAY_POOL_PORT=31989) ;;
*) exit 2 ;;
esac
state="$d/arms/$arm"
systemd-run --user --collect --unit=dsv41-graph275-candidate --property=KillMode=control-group --property=MemoryMax=365G --property=MemorySwapMax=0 --property=TimeoutStopSec=70 --property=StandardOutput=append:"$d/logs/$arm-model.log" --property=StandardError=append:"$d/logs/$arm-model.log" --setenv=CANARY_PORT=18001 --setenv=CANARY_REQUIRE_API_KEY=1 --setenv=CANARY_STATE="$state" --setenv=PEARL_SHAPE_DIR="$state/shapes" --setenv=PEARL_BROKER_SOCKET=/run/user/1000/dsv41-pearl-graph275/broker.sock --setenv=PEARL_PUBLIC_REPLAY=1 "${opts[@]}" "$d/env-run" run
