[Unit]
Description=Four private watched SM120 Pearl offline workers for the DeepSeek canary
[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/mnt/hot/ambientlight/sglang-sm120-runtime/full-canary/miners
ExecStart=/usr/bin/python3 /mnt/hot/ambientlight/sglang-sm120-runtime/full-canary/miners/miners.py serve
RuntimeDirectory=dsv41-sm120-full-miners
RuntimeDirectoryMode=0700
UMask=0077
KillMode=control-group
TimeoutStartSec=120
TimeoutStopSec=12
Restart=no
