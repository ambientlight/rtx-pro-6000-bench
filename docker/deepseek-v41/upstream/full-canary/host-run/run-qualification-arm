#!/usr/bin/env bash
set -eu
arm="$1"
bench="docker/deepseek-v41/upstream/full-canary"
runtime="/mnt/hot/ambientlight/sglang-sm120-runtime/full-canary"
unset CANARY_API_KEY_FILE
case "$arm" in
stock)
  port=18000
  ;;
incumbent)
  port=8000
  python3 "$bench/qualify.py" --port "$port" --baseline "$bench/incumbent.json" --receipt "$bench/incumbent-unlocked.json" > "$runtime/incumbent-unlocked.log" 2>&1
  ;;
*)
  exit 2
  ;;
esac
for phase in native prefix handbook; do
  python3 "$bench/throughput.py" --port "$port" --phase "$phase" --handbook-sizes 32768 131072 200000 --handbook-long-budget 512 --receipt "$bench/$arm-$phase.json" > "$runtime/$arm-$phase.log" 2>&1
done
